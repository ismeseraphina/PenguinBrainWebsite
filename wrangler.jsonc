{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "penguinbrain",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/user", "/repos/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "penguinbrain", "database_id": "__D1_ID__" }
  ],
  "observability": { "enabled": true }
}
